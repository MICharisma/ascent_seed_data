    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+(?:-[A-Za-z0-9_]+)*$(?![\\s\\S])"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$(?![\\s\\S])"
    },
    "scope": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$(?![\\s\\S])"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "\\S"
          },
          {
            "type": "integer"
          }
        ]
      }
    },
    "source": {
      "type": "object",
      "description": "Optional source metadata; URLs and timestamps are not required."
    },
    "sequence": {
      "description": "Numeric or named selection; staged family/member choices are interpreted by the reader.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        {
          "type": "string",
          "pattern": "^(?:[0-9]{1,2}_[0-9]{1,2}|[A-Za-z][A-Za-z0-9_]*)$(?![\\s\\S])"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              },
              {
                "type": "string",
                "pattern": "^(?:[0-9]{1,2}|[A-Za-z][A-Za-z0-9_]*)$(?![\\s\\S])"
              }
            ]
          }
        }
      ]
    },
    "reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/code"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/code"
            },
            "entity_sequence": {
              "$ref": "#/$defs/sequence"
            },
            "scope": {
              "$ref": "#/$defs/scope"
            },
            "namespace": {
              "$ref": "#/$defs/token"
            },
            "catalog": {
              "$ref": "#/$defs/token"
            }
          },
          "required": [
            "code"
          ],
          "additionalProperties": false
        }
      ]
    },
